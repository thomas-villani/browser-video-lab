{
  "name": "browser-video-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "videodoc: read, search and redact videos in the browser (WebCodecs, WebGPU, ONNX Runtime Web); nothing is uploaded",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ort.mjs",
    "models": "node scripts/fetch-models.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "videodoc": "node cli/videodoc.ts",
    "mcp": "node cli/mcp.ts",
    "ui": "node cli/videodoc.ts ui",
    "bench": "node scripts/bench.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "label:select": "node scripts/label-select.mjs",
    "label:bootstrap": "uv run --python 3.12 --with batch-face --with torch --with opencv-python-headless --with \"numpy<2.4\" python -I tools/bootstrap_faces.py public/label",
    "label:tasks": "node scripts/label-tasks.mjs",
    "eval:labels": "node scripts/eval-labels.ts",
    "eval:refine": "node scripts/eval-refine.ts",
    "eval:track": "node scripts/eval-track.ts",
    "cuts": "node scripts/scene-cuts.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.ts\"",
    "fixtures": "node scripts/fixtures.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mediabunny": "^1.62.1",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@webgpu/types": "^0.1.74",
    "coi-serviceworker": "0.1.7",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "bin": {
    "videodoc": "cli/videodoc.ts",
    "videodoc-mcp": "cli/mcp.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
